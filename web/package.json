{
  "name": "tenantforge-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
    "format": "prettier --write src tests e2e *.ts *.json .prettierrc.json index.html README.md",
    "format:check": "prettier --check src tests e2e *.ts *.json .prettierrc.json index.html README.md"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.14.7",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.2",
    "otpauth": "9.5.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
