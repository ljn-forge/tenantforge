# Run python3 scripts/init-env.py to generate a private local .env.
# Never deploy these placeholders. Local compose binds loopback by default.
TF_DB_OWNER_PASSWORD=generate-with-init-env
TF_DB_APP_PASSWORD=generate-with-init-env
TF_MASTER_KEY=generate-with-init-env
TF_LISTEN=127.0.0.1:8090
TF_PUBLIC_URL=http://localhost:5178
TF_COOKIE_SECURE=false
TF_DATA_DIR=.data
TF_WEB_DIR=web/dist
TF_SMTP_HOST=127.0.0.1
TF_SMTP_PORT=1039
TF_SMTP_FROM=tenantforge@localhost
TF_STORAGE_BACKEND=local
TF_INITIAL_ADMIN_USERNAME=admin
TF_INITIAL_ADMIN_PASSWORD=Admin@123456
TF_INITIAL_ADMIN_EMAIL=admin@tenantforge.local
TF_INITIAL_TENANT_NAME=默认租户
# Configure separately for an HTTPS deployment:
# TF_OIDC_ISSUER=https://identity.example.com
# TF_OIDC_CLIENT_ID=
# TF_OIDC_CLIENT_SECRET=
# TF_SMTP_USER=
# TF_SMTP_PASSWORD=
# TF_S3_ENDPOINT=
# TF_S3_REGION=
# TF_S3_BUCKET=
# TF_S3_ACCESS_KEY=
# TF_S3_SECRET_KEY=
